{
  "name": "little-blue-market-functions",
  "description": "Commerce proxy, catalog mirror and order pipeline.",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/rules.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "deploy:dev": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes,storage,hosting --project dev",
    "deploy:prod": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes,storage,hosting --project prod",
    "logs": "firebase functions:log --project dev",
    "logs:prod": "firebase functions:log --project prod",
    "secrets:dev": "firebase functions:secrets:set --project dev",
    "secrets:prod": "firebase functions:secrets:set --project prod",
    "doctor": "node scripts/doctor.mjs --project dev",
    "doctor:emu": "node scripts/doctor.mjs --project dev --emulators",
    "doctor:prod": "node scripts/doctor.mjs --project prod",
    "webhooks:dev": "node scripts/register-webhooks.mjs --project dev",
    "webhooks:check": "node scripts/register-webhooks.mjs --project dev --check",
    "webhooks:prod": "node scripts/register-webhooks.mjs --project prod",
    "webhooks:check:prod": "node scripts/register-webhooks.mjs --project prod --check",
    "touch-products": "node scripts/touch-products.mjs --project dev",
    "touch-products:prod": "node scripts/touch-products.mjs --project prod",
    "publish-to-app": "node scripts/publish-to-app.mjs --project dev",
    "publish-to-app:prod": "node scripts/publish-to-app.mjs --project prod",
    "seed": "node scripts/seed.mjs",
    "verify:security": "firebase emulators:exec --only firestore \"node scripts/verify-security.mjs\"",
    "claim-code": "node scripts/claim-code-hash.mjs",
    "probe:shipturtle": "node scripts/shipturtle-probe.mjs --project dev",
    "probe:shipturtle:prod": "node scripts/shipturtle-probe.mjs --project prod",
    "shipturtle:vendors": "node scripts/shipturtle-vendors.mjs --project dev",
    "shipturtle:vendors:prod": "node scripts/shipturtle-vendors.mjs --project prod",
    "inspect:product": "node scripts/inspect-product.mjs --project dev",
    "move-stock": "node scripts/move-stock.mjs --project dev",
    "peek": "node scripts/peek.mjs --project dev",
    "peek:prod": "node scripts/peek.mjs --project prod",
    "replay-order": "node scripts/replay-order.mjs --project dev",
    "wp:probe": "node scripts/wp-probe.mjs --project dev",
    "wp:probe:prod": "node scripts/wp-probe.mjs --project prod",
    "deploy:hosting": "firebase deploy --only hosting --project dev",
    "deploy:hosting:prod": "firebase deploy --only hosting --project prod"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.1",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "typescript": "^5.7.0"
  }
}

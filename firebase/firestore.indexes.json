{
  "indexes": [
    {
      "_comment": "The feed: newest first, optionally narrowed to hashtags.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "tags",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Somebody's own posts, newest first.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "authorId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "A storefront: one seller's listings.",
      "collectionGroup": "catalog",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "The radius search. Geohash prefixes are range-scanned, so the hash must be the last ordered field. See Risk: Firestore cannot combine this with array-contains, which is why text ranking happens over the candidate set.",
      "collectionGroup": "catalog",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "active",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "geohash",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "Search by product type within a radius.",
      "collectionGroup": "catalog",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "typeSlug",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "geohash",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "Threads in a forum, newest first.",
      "collectionGroup": "threads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "forumId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "The inbox: your conversations, most recent first.",
      "collectionGroup": "conversations",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "participantIds",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "lastMessageAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "A seller's orders, for the sales tab.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerUids",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "placedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "A buyer's orders.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "buyerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "placedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Reviews carrying a hashtag, across every product.",
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "tags",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Browsing a collection (an initiative or a category), newest first.",
      "collectionGroup": "catalog",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "collectionHandles",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "A seller's own drafts, newest first.",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "The admin's queue: applications waiting, newest first.",
      "collectionGroup": "sellerApplications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Stage 10: a directory owner's own listings, newest first (every status).",
      "collectionGroup": "directoryListings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ownerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Stage 10: a directory owner's published listings on their public profile.",
      "collectionGroup": "directoryListings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ownerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Stage 13: a directory business's website-link products, newest first.",
      "collectionGroup": "directoryProducts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ownerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "People search: sellers by handle prefix. Was created by hand on the dev project (from the error link) and missed on prod until 2026-09-09.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "isSeller",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "handleLower",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
